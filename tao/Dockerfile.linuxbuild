# Linux build for the Wails app (run under linux/amd64)
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH

# Wails Linux build deps + toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential pkg-config \
        libgtk-3-dev libwebkit2gtk-4.0-dev \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install a recent Go (matches go.mod)
ARG GO_VERSION=1.26.3
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz

# Install Wails CLI
RUN go install github.com/wailsapp/wails/v2/cmd/wails@v2.12.0

WORKDIR /app
COPY . .

RUN wails build -platform linux/amd64 -clean

# Export stage: only the built binary
FROM scratch AS export
COPY --from=builder /app/build/bin/temporaliza /temporaliza
